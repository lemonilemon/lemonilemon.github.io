---
// The moving parts of the Space Travel screen, positioned by space-travel.ts.
import { SPARK } from '../../scripts/home/sky';
---

<g class="line" fill="none" stroke-width="1" stroke-opacity="0.12">
  <circle data-orbit></circle>
  <circle data-orbit></circle>
  <circle data-orbit></circle>
</g>
<g class="line" fill="none" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" data-trail></g>
<path class="line" fill="none" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="0.5 4" stroke-opacity="0.55" data-path></path>
<path class="line" d="M-3 -3 L3 3 M3 -3 L-3 3" stroke-width="1.2" stroke-linecap="round" style="display: none" data-path-crash></path>
<g class="line" fill="none" stroke-width="1" stroke-dasharray="2 2.5">
  <circle style="display: none" data-ghost></circle>
  <circle style="display: none" data-ghost></circle>
  <circle style="display: none" data-ghost></circle>
</g>
<circle fill="currentColor" fill-opacity="0.06" data-sun-halo></circle>
<path fill="currentColor" d={SPARK} data-sun></path>
<g class="glass line" stroke-width="1">
  <circle data-planet></circle>
  <circle data-planet></circle>
  <circle data-planet></circle>
</g>
<g class="hud" fill="currentColor" fill-opacity="0.5">
  <text data-label>SUN</text>
  <text data-label>VENUS</text>
  <text data-label>EARTH</text>
  <text data-label>MARS</text>
</g>
<g data-ship>
  <path class="line" d="M0 4 L0 11" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="2 2" data-fwd></path>
  <path class="line" d="M-2 -8 L-3 -12 M2 -8 L3 -12" stroke-width="1.1" stroke-linecap="round" data-back></path>
  <path class="line" d="M0 -7 L4.4 5 L0 2.6 L-4.4 5 Z" fill="currentColor" stroke-width="0.8" stroke-linejoin="round"></path>
</g>
<g class="line" style="display: none" data-stick>
  <circle fill="none" stroke-width="1" stroke-opacity="0.3" data-stick-ring></circle>
  <circle fill="currentColor" fill-opacity="0.12" stroke-width="1" stroke-opacity="0.55" data-stick-knob></circle>
</g>
<path class="line" d="M0 -8 L0 -13 M7 0 L12 0 M0 8 L0 13 M-7 0 L-12 0 M5 -5 L9 -9 M5 5 L9 9 M-5 5 L-9 9 M-5 -5 L-9 -9" stroke-width="1.2" stroke-linecap="round" style="display: none" data-boom></path>
