---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { CV } from '../consts';

// Builds run from the project root, so public/ resolves from the working directory.
const hasPdf = existsSync(resolve('public', `.${CV.pdf}`));
// The deploy workflow passes the date CV/public.pdf last changed in the resume repo.
const updated = process.env.CV_UPDATED
  ? new Date(`${process.env.CV_UPDATED}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;
---

<Base title="CV" stars={907} noindex>
  <div class="cv">
    <div class="head">
      <h1 class="page-title">CV</h1>
      {
        hasPdf && (
          <div class="actions">
            {updated && <span class="updated">Updated {updated}</span>}
            <a class="u open" href={CV.pdf}>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 2.5H2.5v7h7v-2M6.5 2h3.5v3.5M10 2 5.5 6.5" /></svg>
              Open PDF
            </a>
            <a class="u download" href={CV.pdf} download>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 1.5v6.5M3.2 5.4 6 8.2l2.8-2.8M2 10.5h8" /></svg>
              Download PDF
            </a>
          </div>
        )
      }
    </div>
    {
      hasPdf ? (
        <>
          <svg class="filters" aria-hidden="true" focusable="false">
            {/* Dark mode: black to the ink, white to the surface; script keeps these on the theme's colors. */}
            <filter id="cv-night" color-interpolation-filters="sRGB">
              <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0.2126 0.7152 0.0722 0 0 0 0 0 1 0" />
              <feComponentTransfer>
                <feFuncR type="table" tableValues="0.9098 0.0902" />
                <feFuncG type="table" tableValues="0.902 0.102" />
                <feFuncB type="table" tableValues="0.8745 0.1255" />
              </feComponentTransfer>
            </filter>
          </svg>
          <div class="pages" data-cv-pages data-src={CV.pdf} aria-label="CV, rendered from the PDF">
            {/* The first sheet holds the page's place while the PDF loads. */}
            <div class="sheet" data-sheet>
              <noscript>
                <p class="note">
                  The CV is a PDF: <a class="u" href={CV.pdf}>open it</a>.
                </p>
              </noscript>
            </div>
          </div>
        </>
      ) : (
        <p class="note">The CV is not up yet.</p>
      )
    }
  </div>
</Base>

<script>
  import * as pdfjs from 'pdfjs-dist';
  import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import { currentTheme } from '../scripts/theme';

  pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;

  type Sheet = { page: pdfjs.PDFPageProxy; el: HTMLElement };

  const host = document.querySelector<HTMLElement>('[data-cv-pages]');

  // A CSS color as red, green and blue from 0 to 1, read back through a canvas.
  function channels(color: string) {
    const ctx = document.createElement('canvas').getContext('2d')!;
    ctx.fillStyle = color.trim();
    const hex = String(ctx.fillStyle);
    return [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  }

  // In dark mode CSS recolors the drawing through the #cv-night filter, black
  // to the site's ink and white to its surface; this keeps the filter on the
  // theme's current colors.
  function tint() {
    if (currentTheme() !== 'dark') return;
    const css = getComputedStyle(document.documentElement);
    const ink = channels(css.getPropertyValue('--ink'));
    const surface = channels(css.getPropertyValue('--surface'));
    document.querySelectorAll('#cv-night feComponentTransfer > *').forEach((fn, i) => {
      fn.setAttribute('tableValues', `${ink[i]} ${surface[i]}`);
    });
  }

  // Some phones leave a canvas blank past about 16.7 million pixels.
  const MAX_PIXELS = 16_000_000;

  async function draw(sheets: Sheet[]) {
    // Phones get twice the pixels so a pinch-zoom stays sharp.
    const phone = window.matchMedia('(max-width: 720px)').matches;
    const ratio = Math.min(window.devicePixelRatio || 1, 3) * (phone ? 2 : 1);
    for (const sheet of sheets) {
      const base = sheet.page.getViewport({ scale: 1 });
      const fit = Math.sqrt(MAX_PIXELS / (base.width * base.height));
      const viewport = sheet.page.getViewport({ scale: Math.min((sheet.el.clientWidth / base.width) * ratio, fit) });
      const canvas = document.createElement('canvas');
      canvas.width = Math.floor(viewport.width);
      canvas.height = Math.floor(viewport.height);
      canvas.setAttribute('aria-hidden', 'true');
      await sheet.page.render({ canvas, viewport }).promise;
      sheet.el.prepend(canvas);
    }
  }

  // Transparent text over the drawing, for selecting, copying, find-in-page
  // and screen readers.
  async function addText(sheet: Sheet) {
    const layer = document.createElement('div');
    layer.className = 'textLayer';
    sheet.el.append(layer);
    await new pdfjs.TextLayer({
      textContentSource: sheet.page.streamTextContent(),
      container: layer,
      viewport: sheet.page.getViewport({ scale: 1 }),
    }).render();
  }

  // The PDF's links, as real links laid over the drawing.
  async function addLinks(sheet: Sheet) {
    const base = sheet.page.getViewport({ scale: 1 });
    const layer = document.createElement('div');
    layer.className = 'linkLayer';
    for (const annotation of await sheet.page.getAnnotations()) {
      if (annotation.subtype !== 'Link' || !annotation.url) continue;
      const [x1, y1] = base.convertToViewportPoint(annotation.rect[0], annotation.rect[1]);
      const [x2, y2] = base.convertToViewportPoint(annotation.rect[2], annotation.rect[3]);
      const link = document.createElement('a');
      link.href = annotation.url;
      link.setAttribute('aria-label', annotation.url.replace(/^https?:\/\//, '').replace(/\/$/, ''));
      Object.assign(link.style, {
        left: `${(Math.min(x1, x2) / base.width) * 100}%`,
        top: `${(Math.min(y1, y2) / base.height) * 100}%`,
        width: `${(Math.abs(x2 - x1) / base.width) * 100}%`,
        height: `${(Math.abs(y2 - y1) / base.height) * 100}%`,
      });
      layer.append(link);
    }
    sheet.el.append(layer);
  }

  async function renderCv(host: HTMLElement) {
    const pdf = await pdfjs.getDocument({ url: host.dataset.src! }).promise;
    const first = host.querySelector<HTMLElement>('[data-sheet]')!;
    const sheets: Sheet[] = [];
    for (let n = 1; n <= pdf.numPages; n++) {
      const page = await pdf.getPage(n);
      const el = n === 1 ? first : host.appendChild(first.cloneNode(false) as HTMLElement);
      const base = page.getViewport({ scale: 1 });
      el.replaceChildren();
      el.style.aspectRatio = `${base.width} / ${base.height}`;
      sheets.push({ page, el });
    }
    // The text layer sizes itself from this, so it follows the sheet's width without redrawing.
    const fit = () => {
      for (const { page, el } of sheets) {
        el.style.setProperty('--total-scale-factor', String(el.clientWidth / page.getViewport({ scale: 1 }).width));
      }
    };
    fit();
    new ResizeObserver(fit).observe(host);
    await draw(sheets);
    requestAnimationFrame(() => (host.dataset.state = 'ready'));
    await Promise.all(sheets.map((sheet) => Promise.all([addText(sheet), addLinks(sheet)])));
  }

  if (host) {
    tint();
    document.addEventListener('themechange', tint);
    renderCv(host).catch(() => {
      const note = document.createElement('p');
      note.className = 'note';
      const link = document.createElement('a');
      link.className = 'u';
      link.href = host.dataset.src!;
      link.textContent = 'Open the PDF';
      note.append('The preview could not load. ', link, '.');
      host.replaceChildren(note);
    });
  }
</script>

<style>
  .cv {
    width: min(760px, 100%);
    margin: 0 auto;
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    font-family: var(--font-label);
    font-size: 13px;
    color: var(--muted);
  }
  .download,
  .open {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 0;
    margin: -12px 0;
  }
  /* On phones the preview is too small to read without zooming, so the
     phone's own PDF viewer is one tap away. */
  .open {
    display: none;
  }
  .pages {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* Holds the dark-mode filter; display: none would switch the filter off too. */
  .filters {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* A sheet of paper on the desk; at night, the page recolored to the site's own colors. */
  .sheet {
    --paper: #ffffff;
    --blend: multiply;
    --recolor: none;
    --scale-round-x: 1px;
    --scale-round-y: 1px;
    position: relative;
    aspect-ratio: 595.276 / 841.89;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 2px;
    box-shadow:
      0 1px 2px rgba(23, 24, 26, 0.05),
      0 24px 48px -28px rgba(23, 24, 26, 0.22);
    overflow: hidden;
  }
  :global(:root[data-theme='dark']) .sheet {
    --paper: var(--surface);
    --blend: screen;
    --recolor: url(#cv-night);
    box-shadow: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .sheet {
      --paper: var(--surface);
      --blend: screen;
      --recolor: url(#cv-night);
      box-shadow: none;
    }
  }
  @media (scripting: none) {
    .sheet {
      aspect-ratio: auto;
      padding: 28px 32px;
    }
  }
  .sheet :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    filter: var(--recolor);
    transition: opacity 0.4s ease;
  }
  .pages:not([data-state='ready']) :global(canvas) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet :global(canvas) {
      transition: none;
    }
  }

  /* PDF.js's text layer, trimmed to what one page needs. Blending lets the
     site's selection color sit under the drawn glyphs instead of over them. */
  .sheet :global(.textLayer) {
    --min-font-size: 1;
    --text-scale-factor: calc(var(--total-scale-factor) * var(--min-font-size));
    --min-font-size-inv: calc(1 / var(--min-font-size));
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: clip;
    line-height: 1;
    text-align: initial;
    text-size-adjust: none;
    -webkit-text-size-adjust: none;
    forced-color-adjust: none;
    transform-origin: 0 0;
    mix-blend-mode: var(--blend);
  }
  .sheet :global(.textLayer :is(span, br)) {
    color: transparent;
    position: absolute;
    white-space: pre;
    cursor: text;
    transform-origin: 0% 0%;
  }
  .sheet :global(.textLayer > :not(.markedContent)),
  .sheet :global(.textLayer .markedContent span:not(.markedContent)) {
    --font-height: 0;
    --scale-x: 1;
    --rotate: 0deg;
    z-index: 1;
    font-size: calc(var(--text-scale-factor) * var(--font-height));
    transform: rotate(var(--rotate)) scaleX(var(--scale-x)) scale(var(--min-font-size-inv));
  }
  .sheet :global(.textLayer .markedContent) {
    display: contents;
  }
  .sheet :global(.textLayer ::selection) {
    background: var(--selection);
    color: transparent;
  }
  .sheet :global(.textLayer br::selection) {
    background: transparent;
  }
  .sheet :global(.textLayer .endOfContent) {
    display: block;
    position: absolute;
    inset: 100% 0 0;
    z-index: 0;
    cursor: default;
    user-select: none;
  }

  .sheet :global(.linkLayer) {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    mix-blend-mode: var(--blend);
  }
  .sheet :global(.linkLayer a) {
    position: absolute;
    pointer-events: auto;
    border-radius: 2px;
  }
  .sheet :global(.linkLayer a:hover) {
    background: var(--selection);
  }
  .sheet :global(.linkLayer a:focus-visible) {
    outline: 1.5px solid var(--ink);
    outline-offset: 2px;
  }

  .cv :global(.note) {
    margin: 0;
    font-size: 19px;
    line-height: 1.75;
    color: var(--body);
  }
  @media (max-width: 720px) {
    .cv {
      padding-top: 40px;
    }
    .open {
      display: flex;
    }
    .updated {
      flex-basis: 100%;
    }
  }
</style>
