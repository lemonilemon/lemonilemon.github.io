---
import { SITE } from '../consts';

const year = new Date().getFullYear();
const years = year > SITE.since ? `${SITE.since}–${year}` : `${SITE.since}`;
const onColophon = Astro.url.pathname.replace(/\/$/, '') === '/colophon';
---

<footer class="footer">
  <span>© {years} lemonilemon</span>
  <span class="links">
    <a class="u" href="/rss.xml">RSS</a>
    <a class="u" href={SITE.source}>Source</a>
    <a class="u" href="/colophon/" aria-current={onColophon ? 'page' : undefined}>Colophon</a>
    <slot />
  </span>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 3;
    padding: 0 var(--gutter) 30px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 16px;
    flex-shrink: 0;
    font-family: var(--font-label);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .footer > span:first-child {
    white-space: nowrap;
  }
  .links {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .links a {
    color: var(--muted);
  }
  .links a[aria-current='page'] {
    color: var(--ink);
  }
  @media (max-width: 720px) {
    .footer {
      padding-bottom: 24px;
      font-size: 11.5px;
    }
    .links {
      gap: 16px;
    }
  }
</style>
